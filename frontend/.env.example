# Backend API base URL (CONNECT.PH Clinic Platform API)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Application metadata
NEXT_PUBLIC_APP_NAME=CONNECT.PH Clinic Platform
NEXT_PUBLIC_APP_ENV=development

# Post-RC1 Phase 2.5: shown on the System Status dashboard as "Frontend
# Version" (self-reported - no clean way for the backend to know the
# frontend's deployed version since it's a separate Vercel deployment).
# Keep in sync with frontend/package.json's "version".
NEXT_PUBLIC_APP_VERSION=1.7.0-rc1

# Auth cookie name used by middleware for route protection (client-set on login)
NEXT_PUBLIC_AUTH_COOKIE_NAME=cph_session

# Optional: for single-clinic/single-TV on-prem deployments, sets the
# public_slug the bare /tv route (no slug in URL) resolves to. Leave unset
# for shared multi-tenant deployments - use /tv/<slug> directly instead.
# NEXT_PUBLIC_DEFAULT_TV_SLUG=
