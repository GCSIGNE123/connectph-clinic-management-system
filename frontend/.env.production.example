# Post-RC1 Phase 2.5: Production Cloud Deployment
#
# Template for the production Vercel deployment. Do NOT commit a real
# `.env.production` with production values - set these as actual Vercel
# Project Environment Variables (Project Settings -> Environment Variables,
# scope: Production) instead; this file only documents which ones to set.
# See DEPLOYMENT.md's "Frontend deployment (Vercel)" section.

NEXT_PUBLIC_API_URL=https://clinic-api.connectph-it.com/api/v1
NEXT_PUBLIC_APP_NAME=CONNECT.PH Clinic Platform
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_VERSION=1.7.0-rc1
NEXT_PUBLIC_AUTH_COOKIE_NAME=cph_session
# NEXT_PUBLIC_DEFAULT_TV_SLUG= (only for a single-clinic bare /tv deployment)
