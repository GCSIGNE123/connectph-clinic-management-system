# Post-RC1 Phase 2.6: Local Production Deployment (Windows Auto-Start)
#
# Template for the REAL clinic-desktop production runtime, running as
# `next start` (built via `next build`) instead of `next dev`, auto-started
# on Windows boot alongside the backend. Different target than
# `.env.production.example` (that one is the future Vercel/cloud deployment
# from Phase 2.5 — a separately-hosted frontend talking to a public API
# domain over HTTPS). This file is for the frontend running ON the same
# clinic machine as the backend, reached over the clinic LAN.
#
# Copy to `frontend/.env.production` on the clinic machine (git-ignored,
# same convention as every other profile — only this `.example` file is
# tracked; Next.js automatically loads `.env.production` when
# `NODE_ENV=production`, which `next build`/`next start` set implicitly).
#
# See docs/LOCAL_DEPLOYMENT.md for the full walkthrough.

# Backend API base URL — same machine, LAN-reachable. Plain HTTP (no TLS)
# is the deliberate, documented choice for the first clinic install; see
# docs/LOCAL_DEPLOYMENT.md §Network Configuration.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_APP_NAME=CONNECT.PH Clinic Platform
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_VERSION=1.7.0-rc1
NEXT_PUBLIC_AUTH_COOKIE_NAME=cph_session
# NEXT_PUBLIC_DEFAULT_TV_SLUG=<paste-this-clinic's-real-TV-display-slug>
