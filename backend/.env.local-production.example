# Post-RC1 Phase 2.6: Local Production Deployment (Windows Auto-Start)
#
# Template for the REAL clinic-desktop production runtime — the actual
# machine sitting in the clinic (e.g. the doctor's PC at Canora Medical
# Clinic), started automatically on Windows boot via the scripts in
# `deploy/windows/`. This is a DIFFERENT target than
# `.env.production.example` (that one is the future cloud/VPS deployment
# from Phase 2.5 — Nginx, HTTPS, a public domain). This file is for the
# on-prem machine that IS the primary/source-of-truth database, reachable
# only over the clinic's own LAN.
#
# Copy to `backend/.env.production` on the clinic machine (git-ignored,
# same convention as every other profile in this repo — only this
# `.example` file is tracked) and fill in every `<...>` placeholder. The
# NSSM service install script (`deploy/windows/install-backend-service.bat`)
# points `AppEnvironmentExtra`/working directory at this `.env` file via
# uvicorn's normal `.env` loading (`backend/app/core/config.py`,
# `env_file=".env"` — note it always loads a file literally named `.env`,
# so on the clinic machine this file must be copied/renamed to `.env`, not
# left as `.env.production.example` or `.env.production`).
#
# See docs/LOCAL_DEPLOYMENT.md for the full walkthrough.

ENV=production
DEBUG=false

# --- Database: the existing portable Postgres in .devdb/ (or an equivalent
# copy on the clinic machine), UNCHANGED data directory/port from dev.
# Do NOT install real PostgreSQL Server (EnterpriseDB) — keep using the
# portable instance that already exists. See deploy/windows/README or
# docs/LOCAL_DEPLOYMENT.md for exact paths. ---
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_password@localhost:5433/connectph_clinic

# --- JWT / Auth: generate a real production secret, never reuse the dev
# value ("change-me-to-a-random-secret-in-production" or
# "dev-only-not-for-production"). Run:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<generate-a-long-random-secret-never-reuse-dev-value>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cookies: this is plain http://<LAN-IP>:8000 (no TLS — see
# docs/LOCAL_DEPLOYMENT.md §Network Configuration for why a reverse proxy
# is not being force-installed for the first clinic install). COOKIE_SECURE
# must be false here or the browser will silently refuse to store the
# refresh-token cookie over plain HTTP and login will appear broken. This
# is the one deliberate deviation from the cloud `.env.production.example`
# (which correctly keeps COOKIE_SECURE=true behind real HTTPS). ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Redis: not required for this phase's local-only flows; leave the
# default unless a future phase adds a hard Redis dependency. ---
REDIS_URL=redis://localhost:6379/0

# --- CORS: the frontend is served from the SAME machine, reached by staff
# workstations over LAN at http://<Doctor-PC-IP>:3000. List every hostname/
# IP staff will actually type, comma-separated, no trailing slash. Update
# this if the clinic's LAN IP ever changes (e.g. after a router reset) —
# see docs/LOCAL_DEPLOYMENT.md §Network Configuration for making it static. ---
CORS_ORIGINS=http://localhost:3000,http://<Doctor-PC-LAN-IP>:3000

# --- SMTP: optional for a local-only clinic (no outbound email flows are
# on this machine's critical path); leave the placeholder default if unused. ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@connect.ph
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@connect.ph

# --- Post-RC1 Phase 2 Milestones 1-2 / Phase 2.5: deployment mode ---
# This IS the local clinic install — DEPLOYMENT_MODE=local by default.
# Only switch to "hybrid" + set CLOUD_* below once a real Cloud Server
# (Phase 2.5's VPS target) has actually been deployed and this clinic is
# ready to start uploading backups to it. Until then, leave this exactly
# as-is; every existing local-only workflow behaves identically.
DEPLOYMENT_MODE=local
# CLOUD_API_URL=https://cloud.connectph-it.com
# CLOUD_SYNC_API_KEY=<same-shared-secret-as-the-cloud-server>
SYNC_WORKER_INTERVAL_SECONDS=30
SYNC_RETRY_BASE_SECONDS=30
SYNC_RETRY_MAX_SECONDS=1800
