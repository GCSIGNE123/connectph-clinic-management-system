# Post-RC1 Phase 2.5: Production Cloud Deployment
#
# This file documents the LOCAL CLINIC DEV template - copy to `.env` (the
# existing Milestone 1 pattern; `.env` is what `Settings` actually loads,
# see backend/app/core/config.py's `env_file=".env"`) for day-to-day
# development against a local/Docker Postgres. It is functionally the same
# content as `.env.example` - kept as a second, explicitly-named file so the
# three real-world profiles (dev / local clinic runtime / production VPS)
# are each documented by a same-named file instead of forcing the reader to
# infer clinic-runtime vs. cloud-VPS config from one generic example.
#
# DEPLOYMENT_MODE=local, no CLOUD_* vars set: full local-only behavior,
# identical to every clinic install that predates Phase 2.

ENV=development
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_password@localhost:5432/connectph_clinic
JWT_SECRET_KEY=dev-only-not-for-production
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEPLOYMENT_MODE=local
# CLOUD_API_URL / CLOUD_DATABASE_URL / CLOUD_SYNC_API_KEY left unset - see
# .env.example for full descriptions of every variable.
