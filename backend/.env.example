# --- Database ---
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_password@localhost:5432/connectph_clinic

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@connect.ph
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@connect.ph

# --- Supabase (storage / auxiliary services) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=clinic-documents

# --- App ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENV=development

# --- Post-RC1 Phase 2 Milestone 1: Cloud Readiness (groundwork only) ---
# DEPLOYMENT_MODE: "local" (default - fully offline/on-prem clinic, no cloud
# backend) or "hybrid" (a cloud backend is expected to eventually exist).
# Absent/unset behaves exactly like "local" - no business logic branches on
# this yet, it only affects the System Status panel's labeling.
DEPLOYMENT_MODE=local

# CLOUD_API_URL: base URL of the future cloud backend. Optional - leave unset
# for local-only clinics (the realistic day-one state). Used ONLY by the
# Connectivity Service's lightweight reachability check; nothing else reads
# it yet. When unset, Cloud Server Status reports "Not Configured".
# CLOUD_API_URL=https://cloud.connect.ph

# CLOUD_DATABASE_URL: placeholder for a future cloud Postgres connection
# string (Milestone 2 / Cloud Backup). NOT used for any real connection in
# Milestone 1 - do not point this at a real database expecting behavior.
# CLOUD_DATABASE_URL=postgresql+asyncpg://user:password@cloud-host:5432/db

# --- Post-RC1 Phase 2 Milestone 2: Cloud Backup (One-Way Sync) ---
# CLOUD_SYNC_API_KEY: shared secret this local instance sends as
# `X-Sync-Api-Key` when calling a cloud instance's `/api/v1/backup/*`
# endpoints, and that a cloud-deployed instance of this same codebase checks
# incoming requests against. Set to the SAME value on both sides. Leave
# unset for local-only clinics - the sync worker then simply never succeeds
# a sync attempt (jobs stay queued/retry) rather than the app failing to
# start.
# CLOUD_SYNC_API_KEY=change-me-to-a-random-shared-secret

# How often (seconds) the background sync worker checks the local queue.
SYNC_WORKER_INTERVAL_SECONDS=30
# Exponential backoff bounds for failed sync jobs (base * 2^retry, capped).
SYNC_RETRY_BASE_SECONDS=30
SYNC_RETRY_MAX_SECONDS=1800
