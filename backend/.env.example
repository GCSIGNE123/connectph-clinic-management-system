# --- Database ---
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_password@localhost:5432/connectph_clinic

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@connect.ph
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@connect.ph

# --- Supabase (storage / auxiliary services) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=clinic-documents

# --- App ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENV=development
