# Post-RC1 Phase 2.5: Production Cloud Deployment
#
# Template for a PRODUCTION VPS deployment of the backend (the Local Clinic
# Server, or - if this exact codebase is also deployed to a second VPS as
# the Cloud Backup target - the Cloud Server too; both use this same app,
# just with different DEPLOYMENT_MODE/CLOUD_* values). Copy to `.env` on the
# server, fill in every `<...>` placeholder, and NEVER commit the filled-in
# file (`.env` and `.env.production` are both gitignored - see `.gitignore`;
# only this `.example` file is tracked).
#
# See DEPLOYMENT.md for the full setup walkthrough (systemd unit, Nginx
# reverse proxy, Let's Encrypt) and the full per-variable reference table.

ENV=production

# --- Database: production Postgres (managed or self-hosted on the VPS) ---
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/connectph_clinic

# --- JWT / Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(64))"` ---
JWT_SECRET_KEY=<generate-a-long-random-secret-never-reuse-dev-value>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cookies: HTTPS is mandatory in production (Nginx terminates TLS) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=clinic.connectph-it.com

# --- Redis ---
REDIS_URL=redis://<redis_host>:6379/0

# --- CORS: restrict to the real deployed frontend origin(s) only - no
# wildcard, no localhost, in production. ---
CORS_ORIGINS=https://clinic.connectph-it.com

# --- SMTP (real provider, not smtp.example.com) ---
SMTP_HOST=<smtp_host>
SMTP_PORT=587
SMTP_USER=<smtp_user>
SMTP_PASSWORD=<smtp_password>
SMTP_FROM=no-reply@connectph-it.com

# --- Post-RC1 Phase 2 Milestones 1-2: hybrid/cloud config ---
# Local Clinic Server VPS: set DEPLOYMENT_MODE=hybrid + CLOUD_* to enable
# backup uploads to the Cloud Server. Cloud Server VPS itself: leave
# DEPLOYMENT_MODE=local (it has no "cloud" above it) and only needs
# DATABASE_URL (its own Postgres) + CLOUD_SYNC_API_KEY (to authenticate
# INCOMING backup uploads, checked in app/api/v1/backup.py).
DEPLOYMENT_MODE=hybrid
CLOUD_API_URL=https://cloud.connectph-it.com
CLOUD_DATABASE_URL=postgresql+asyncpg://<cloud_db_user>:<cloud_db_password>@<cloud_db_host>:5432/connectph_cloud_backup
CLOUD_SYNC_API_KEY=<generate-a-long-random-shared-secret-same-value-on-both-sides>

SYNC_WORKER_INTERVAL_SECONDS=30
SYNC_RETRY_BASE_SECONDS=30
SYNC_RETRY_MAX_SECONDS=1800
