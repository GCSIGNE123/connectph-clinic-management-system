{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "postgres",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "backend/scripts/start_dev_postgres.ps1"],
      "cwd": ".",
      "port": 5433,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8010"],
      "cwd": "backend",
      "port": 8010
    }
  ]
}
