# --- Local dev database runtime (portable Postgres binaries + live data dir) ---
.devdb/

# --- Session scratch space (not part of the project) ---
.scratch/

# --- Secrets / local env ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.local-production
!.env.example
!.env.development.example
!.env.production.example
!.env.local-production.example

# --- Backend (Python) ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
venv/
.venv/
backend/backups/
backend/var/
# Generated deployment metadata (git commit + deploy timestamp) - written by
# deploy/windows/update_server.bat via scripts/write_deploy_info.py on every
# deploy, read by app/core/deploy_info.py. Regenerated every deploy, no
# secrets - never a human-edited config file. See docs/UPDATE_PROCEDURE.md.
backend/deploy_info.json

# --- Frontend (Node) ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Misc scratch ---
*.log
